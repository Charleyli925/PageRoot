{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://html-change.local/schemas/source-history.v1.schema.json",
  "title": "PageRoot persistent source operation history v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "documentId",
    "baseSourceSha256",
    "cursor",
    "revision",
    "entries",
    "appliedActions",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "documentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "baseSourceSha256": {
      "$ref": "#/$defs/sha256"
    },
    "cursor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "entries": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "appliedActions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/appliedAction"
      }
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "target": {
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startOffset",
        "endOffset",
        "before",
        "after",
        "kind"
      ],
      "properties": {
        "startOffset": {
          "type": "integer",
          "minimum": 0
        },
        "endOffset": {
          "type": "integer",
          "minimum": 0
        },
        "before": {
          "type": "string",
          "maxLength": 4194304
        },
        "after": {
          "type": "string",
          "maxLength": 4194304
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "kind",
        "editRevision",
        "createdAt",
        "beforeSourceSha256",
        "afterSourceSha256",
        "forwardPatches",
        "reversePatches",
        "beforeTarget",
        "afterTarget"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "pattern": "^sourceop_[A-Za-z0-9_-]{12,180}$"
        },
        "kind": {
          "enum": [
            "text",
            "style",
            "structure",
            "reorder"
          ]
        },
        "property": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "editRevision": {
          "type": "integer",
          "minimum": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "beforeSourceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "afterSourceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "forwardPatches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2048,
          "items": {
            "$ref": "#/$defs/patch"
          }
        },
        "reversePatches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2048,
          "items": {
            "$ref": "#/$defs/patch"
          }
        },
        "beforeTarget": {
          "$ref": "#/$defs/target"
        },
        "afterTarget": {
          "$ref": "#/$defs/target"
        }
      }
    },
    "appliedAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionId",
        "direction",
        "operationId",
        "cursor",
        "revision",
        "sourceSha256",
        "appliedAt"
      ],
      "properties": {
        "actionId": {
          "type": "string",
          "pattern": "^sourceaction_[A-Za-z0-9_-]{12,180}$"
        },
        "direction": {
          "enum": [
            "undo",
            "redo"
          ]
        },
        "operationId": {
          "type": "string",
          "pattern": "^sourceop_[A-Za-z0-9_-]{12,180}$"
        },
        "cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "sourceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "appliedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
