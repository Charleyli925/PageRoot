{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://html-change.local/schemas/input-manifest.v1.schema.json",
  "title": "HTML AI frozen input manifest v1",
  "description": "The complete content-addressed Request inventory plus the ordered subset an internal-AI Attempt must read. Inventory-only audit files stay frozen and hashed without consuming AI context.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "documentId",
    "requestId",
    "attemptId",
    "frozen",
    "createdAt",
    "readOrder",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "projectId": {
      "$ref": "#/$defs/projectId"
    },
    "documentId": {
      "$ref": "#/$defs/documentId"
    },
    "requestId": {
      "$ref": "#/$defs/requestId"
    },
    "attemptId": {
      "$ref": "#/$defs/attemptId"
    },
    "frozen": {
      "const": true
    },
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    },
    "readOrder": {
      "description": "The ordered execution inputs the internal AI must read. Every path is also present in files; inventory-only audit files are intentionally omitted.",
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relativePath"
      }
    },
    "files": {
      "description": "The complete frozen and content-addressed Request inventory, including audit files that are not execution inputs.",
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/file"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "role"
            ],
            "properties": {
              "role": {
                "const": "prompt"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "role"
            ],
            "properties": {
              "role": {
                "const": "change-request"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "role"
            ],
            "properties": {
              "role": {
                "const": "project-rules"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "role"
            ],
            "properties": {
              "role": {
                "const": "base-html"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "role"
            ],
            "properties": {
              "role": {
                "const": "annotations"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "role"
            ],
            "properties": {
              "role": {
                "const": "policy"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role",
        "mediaType",
        "byteLength",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "role": {
          "enum": [
            "prompt",
            "policy",
            "project-rules",
            "change-request",
            "base-html",
            "annotations",
            "comment-attachment",
            "reference",
            "user-supplement"
          ]
        },
        "mediaType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "prompt"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "const": "PROMPT.md"
              },
              "mediaType": {
                "const": "text/markdown"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "change-request"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "const": "change-request.json"
              },
              "mediaType": {
                "const": "application/json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "project-rules"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "const": "input/PROJECT.md"
              },
              "mediaType": {
                "const": "text/markdown"
              }
            }
          },
          "else": {
            "properties": {
              "byteLength": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "base-html"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "const": "input/base/index.html"
              },
              "mediaType": {
                "const": "text/html"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "annotations"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "const": "input/annotations/records.json"
              },
              "mediaType": {
                "const": "application/json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "policy"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "const": "input/AI_RULES.md"
              },
              "mediaType": {
                "const": "text/markdown"
              }
            }
          }
        }
      ]
    },
    "projectId": {
      "type": "string",
      "pattern": "^project_[A-Za-z0-9_-]+$"
    },
    "documentId": {
      "type": "string",
      "pattern": "^doc_[A-Za-z0-9_-]+$"
    },
    "requestId": {
      "type": "string",
      "pattern": "^req_[A-Za-z0-9_-]+$"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^attempt_[0-9]{3}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!\\.\\.?$)(?!\\.\\.?/)(?!.*\\/\\.\\.?\\/)(?!.*\\/\\.\\.?$)[^\\u0000\\r\\n]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
