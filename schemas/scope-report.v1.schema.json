{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://html-change.local/schemas/scope-report.v1.schema.json",
  "title": "HTML AI enforced scope report v1",
  "description": "A deterministic report proving whether one AI output changed only the frozen Request targets plus lifecycle-owned metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "validatorVersion",
    "enforcementMode",
    "projectId",
    "documentId",
    "requestId",
    "attemptId",
    "generatedAt",
    "base",
    "output",
    "managedMetadataWhitelist",
    "allowedTargets",
    "differences",
    "summary",
    "verdict",
    "violationCodes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "validatorVersion": {
      "const": "1.0.0"
    },
    "enforcementMode": {
      "const": "enforce"
    },
    "projectId": {
      "$ref": "#/$defs/projectId"
    },
    "documentId": {
      "$ref": "#/$defs/documentId"
    },
    "requestId": {
      "$ref": "#/$defs/requestId"
    },
    "attemptId": {
      "$ref": "#/$defs/attemptId"
    },
    "generatedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "base": {
      "$ref": "#/$defs/contentIdentity"
    },
    "output": {
      "$ref": "#/$defs/contentIdentity"
    },
    "managedMetadataWhitelist": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "html-ai-document-id",
          "html-ai-version-id",
          "html-ai-version-label",
          "html-ai-based-on-version-id",
          "html-ai-request-id"
        ]
      }
    },
    "allowedTargets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/resolvedTarget"
      }
    },
    "differences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/difference"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "violationCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    }
  },
  "$defs": {
    "contentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "comparisonSha256"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "comparisonSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "resolvedTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "label",
        "level",
        "resolution"
      ],
      "properties": {
        "targetId": {
          "type": "string",
          "pattern": "^target_[A-Za-z0-9_-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "level": {
          "enum": [
            "module",
            "subregion",
            "text",
            "insertion-point"
          ]
        },
        "selector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "textQuote": {
          "type": "string",
          "maxLength": 5000
        },
        "sourceAnchor": {
          "$ref": "#/$defs/sourceAnchor"
        },
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "resolution": {
          "$ref": "#/$defs/resolutionPair"
        }
      }
    },
    "resolutionPair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "output",
        "basePath",
        "outputPath",
        "reason"
      ],
      "properties": {
        "base": {
          "$ref": "#/$defs/resolution"
        },
        "output": {
          "$ref": "#/$defs/resolution"
        },
        "basePath": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4000
        },
        "outputPath": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4000
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 5000
        }
      }
    },
    "difference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "differenceId",
        "kind",
        "classification",
        "operation",
        "allowed",
        "material",
        "targetIds",
        "attributeName",
        "baseLocation",
        "outputLocation",
        "before",
        "after"
      ],
      "properties": {
        "differenceId": {
          "type": "string",
          "pattern": "^difference_[A-Za-z0-9_-]+$"
        },
        "kind": {
          "enum": [
            "text",
            "attribute",
            "structure",
            "inline-style",
            "shared-css",
            "script",
            "finalizer-metadata",
            "semantic-normalization",
            "target-resolution"
          ]
        },
        "classification": {
          "enum": [
            "target-inside",
            "target-outside",
            "finalizer-metadata",
            "semantic-equivalent",
            "unresolved-target"
          ]
        },
        "operation": {
          "enum": [
            "add",
            "remove",
            "modify",
            "move",
            "normalize"
          ]
        },
        "allowed": {
          "type": "boolean"
        },
        "material": {
          "type": "boolean"
        },
        "targetIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^target_[A-Za-z0-9_-]+$"
          }
        },
        "attributeName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "baseLocation": {
          "oneOf": [
            {
              "$ref": "#/$defs/location"
            },
            {
              "type": "null"
            }
          ]
        },
        "outputLocation": {
          "oneOf": [
            {
              "$ref": "#/$defs/location"
            },
            {
              "type": "null"
            }
          ]
        },
        "before": {
          "oneOf": [
            {
              "$ref": "#/$defs/evidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "after": {
          "oneOf": [
            {
              "$ref": "#/$defs/evidence"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "startOffset",
        "endOffset",
        "startLine",
        "startColumn",
        "endLine",
        "endColumn"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "startOffset": {
          "type": "integer",
          "minimum": 0
        },
        "endOffset": {
          "type": "integer",
          "minimum": 0
        },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "startColumn": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "endColumn": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "preview"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "preview": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "differenceCount",
        "materialDifferenceCount",
        "allowedDifferenceCount",
        "violationCount",
        "byKind"
      ],
      "properties": {
        "differenceCount": {
          "type": "integer",
          "minimum": 0
        },
        "materialDifferenceCount": {
          "type": "integer",
          "minimum": 0
        },
        "allowedDifferenceCount": {
          "type": "integer",
          "minimum": 0
        },
        "violationCount": {
          "type": "integer",
          "minimum": 0
        },
        "byKind": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "sourceAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startOffset",
        "endOffset",
        "sourceSha256"
      ],
      "properties": {
        "startOffset": {
          "type": "integer",
          "minimum": 0
        },
        "endOffset": {
          "type": "integer",
          "minimum": 0
        },
        "sourceSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tagName",
        "stableAttributes",
        "ancestorFingerprint"
      ],
      "properties": {
        "tagName": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9:-]*$"
        },
        "stableAttributes": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "ancestorFingerprint": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "textPrefix": {
          "type": "string",
          "maxLength": 500
        },
        "textSuffix": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "resolution": {
      "enum": [
        "exact",
        "rebound",
        "ambiguous",
        "orphaned"
      ]
    },
    "projectId": {
      "type": "string",
      "pattern": "^project_[A-Za-z0-9_-]+$"
    },
    "documentId": {
      "type": "string",
      "pattern": "^doc_[A-Za-z0-9_-]+$"
    },
    "requestId": {
      "type": "string",
      "pattern": "^req_[A-Za-z0-9_-]+$"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^attempt_[0-9]{3}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
