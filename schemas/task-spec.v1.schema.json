{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://html-change.local/schemas/task-spec.v1.schema.json",
  "title": "PageRoot AI task specification v1",
  "description": "The conservative, system-compiled requirements for one immutable AI Request. Comments and change events remain annotation evidence outside this object.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskSchemaVersion",
    "objective",
    "scopePolicy",
    "instructions",
    "globalAcceptanceCriteria",
    "nonGoals",
    "targets",
    "attachments"
  ],
  "properties": {
    "taskSchemaVersion": {
      "const": "1.0.0"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "scopePolicy": {
      "enum": [
        "targets-only",
        "targets-plus-required-dependencies",
        "whole-page"
      ]
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/instruction"
      }
    },
    "globalAcceptanceCriteria": {
      "$ref": "#/$defs/textList"
    },
    "nonGoals": {
      "$ref": "#/$defs/textList"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "https://html-change.local/schemas/change-request.v3.schema.json#/$defs/target"
      }
    },
    "attachments": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "https://html-change.local/schemas/change-request.v3.schema.json#/$defs/attachment"
      }
    }
  },
  "$defs": {
    "textList": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000
      }
    },
    "instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instructionId",
        "priority",
        "text",
        "targetRefs",
        "acceptanceCriteria"
      ],
      "properties": {
        "instructionId": {
          "type": "string",
          "pattern": "^instruction_[A-Za-z0-9_-]+$"
        },
        "priority": {
          "const": "required"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "targetRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^target_[A-Za-z0-9_-]+$"
          }
        },
        "acceptanceCriteria": {
          "$ref": "#/$defs/textList"
        },
        "attachmentRefs": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^attachment_[A-Za-z0-9_-]+$"
          }
        }
      }
    }
  }
}
