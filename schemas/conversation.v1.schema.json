{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://html-change.local/schemas/conversation.v1.schema.json",
  "title": "PageRoot AI conversation record v1",
  "$comment": "One record per Conversation. A Conversation belongs to exactly one Document and never contains another Document's messages. Forward compatible: every required member stays strictly validated, and a member added by a newer PageRoot is preserved unchanged through read, edit and write so an older build never silently deletes it. Preserved members take no part in validation and still count against the record byte budget. Messages are terminal facts only; a streaming fragment is never written, so every stored message is already in a final status. Messages carry no interface or interaction member: an executable action is derived from current product state by the action bar, never read from a stored message.",
  "type": "object",
  "required": [
    "schemaVersion",
    "conversationId",
    "projectId",
    "documentId",
    "title",
    "status",
    "createdAt",
    "updatedAt",
    "archivedAt",
    "activeContextId",
    "lastSequence",
    "revision",
    "contexts",
    "turns",
    "messages"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "conversationId": {
      "$ref": "#/$defs/conversationId"
    },
    "projectId": {
      "$ref": "#/$defs/identity"
    },
    "documentId": {
      "$ref": "#/$defs/identity"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "status": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "archivedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "archivedReason": {
      "enum": [
        "message-limit",
        "user"
      ]
    },
    "supersededByConversationId": {
      "$ref": "#/$defs/conversationId"
    },
    "supersedesConversationId": {
      "$ref": "#/$defs/conversationId"
    },
    "activeContextId": {
      "oneOf": [
        {
          "$ref": "#/$defs/contextId"
        },
        {
          "type": "null"
        }
      ]
    },
    "lastSequence": {
      "type": "integer",
      "minimum": 0
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "contexts": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/context"
      }
    },
    "turns": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/turn"
      }
    },
    "messages": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/message"
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "conversationId": {
      "type": "string",
      "pattern": "^conversation_[A-Za-z0-9_-]{12,180}$"
    },
    "contextId": {
      "type": "string",
      "pattern": "^context_[A-Za-z0-9_-]{12,180}$"
    },
    "turnId": {
      "type": "string",
      "pattern": "^turn_[A-Za-z0-9_-]{12,180}$"
    },
    "messageId": {
      "type": "string",
      "pattern": "^message_[A-Za-z0-9_-]{12,180}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "context": {
      "$comment": "A Context describes the exact page a message is about. It never authorizes a file read or write.",
      "type": "object",
      "required": [
        "contextId",
        "projectId",
        "documentId",
        "sourceSha256",
        "side",
        "createdAt"
      ],
      "properties": {
        "contextId": {
          "$ref": "#/$defs/contextId"
        },
        "projectId": {
          "$ref": "#/$defs/identity"
        },
        "documentId": {
          "$ref": "#/$defs/identity"
        },
        "workingCopyId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "sourceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "basedOnVersionId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "exactVersionId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "requestId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "attemptId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "candidateId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "side": {
          "enum": [
            "working-copy",
            "frozen-base",
            "candidate",
            "review-pair"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "turn": {
      "type": "object",
      "required": [
        "turnId",
        "contextId",
        "mode",
        "status",
        "startedAt"
      ],
      "properties": {
        "turnId": {
          "$ref": "#/$defs/turnId"
        },
        "contextId": {
          "$ref": "#/$defs/contextId"
        },
        "mode": {
          "enum": [
            "discussion",
            "execution",
            "review-discussion"
          ]
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "completed",
            "interrupted",
            "failed",
            "cancelled"
          ]
        },
        "startedMessageId": {
          "oneOf": [
            {
              "$ref": "#/$defs/messageId"
            },
            {
              "type": "null"
            }
          ]
        },
        "modelId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "modelDisplayName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "reasoningEffort": {
          "$comment": "Provenance only. It records that PageRoot applied no explicit override and has no interface element.",
          "const": "qoder-default"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "interruptedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "requestId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "attemptId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "candidateId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      }
    },
    "message": {
      "$comment": "Terminal facts only. No actions, buttons, cardState or disabled member is permitted.",
      "type": "object",
      "required": [
        "messageId",
        "turnId",
        "sequence",
        "actor",
        "kind",
        "status",
        "text",
        "contextId",
        "createdAt"
      ],
      "properties": {
        "messageId": {
          "$ref": "#/$defs/messageId"
        },
        "turnId": {
          "$ref": "#/$defs/turnId"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "actor": {
          "enum": [
            "user",
            "qoder",
            "pageroot"
          ]
        },
        "kind": {
          "enum": [
            "text",
            "progress",
            "decision-outcome",
            "error",
            "context-boundary",
            "permission-boundary",
            "result-summary"
          ]
        },
        "status": {
          "$comment": "A persisted message is always terminal. draft, queued and streaming exist in memory only and are never written.",
          "enum": [
            "completed",
            "interrupted",
            "failed",
            "cancelled"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 131072
        },
        "truncated": {
          "type": "boolean"
        },
        "contextId": {
          "$ref": "#/$defs/contextId"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "parentMessageId": {
          "oneOf": [
            {
              "$ref": "#/$defs/messageId"
            },
            {
              "type": "null"
            }
          ]
        },
        "modelId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "modelDisplayName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "reasoningEffort": {
          "const": "qoder-default"
        },
        "requestId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "attemptId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "candidateId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      }
    }
  }
}
