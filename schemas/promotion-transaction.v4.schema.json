{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pageroot.local/schemas/promotion-transaction.v4.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "state",
    "transactionId",
    "projectId",
    "documentId",
    "candidateId",
    "requestId",
    "versionId",
    "versionOrdinal",
    "candidateOutputSha256",
    "basedOnVersionId",
    "previousVersionId",
    "finalWorkingCopyRelativePath",
    "preparedWorkingCopyRelativePath",
    "preferredFileStem",
    "preferredExtension",
    "pathAllocationOrdinal",
    "preparedWorkingCopyFileIdentity",
    "publicationWorkingCopyGuardRelativePath",
    "publicationWorkingCopyReplacementRelativePath",
    "workingCopy",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": "4.0.0" },
    "kind": { "const": "promotion" },
    "state": { "enum": ["prepared", "snapshot-created", "working-copy-prepared", "working-copy-created", "working-copy-staged", "working-copy-published", "manifest-committed", "completed"] },
    "transactionId": { "type": "string", "pattern": "^promote_candidate_[A-Za-z0-9_-]{8,160}$" },
    "projectId": { "type": "string", "pattern": "^project_[a-f0-9]{16,64}$" },
    "documentId": { "type": "string", "pattern": "^doc_[a-f0-9]{16,64}$" },
    "candidateId": { "type": "string", "pattern": "^candidate_[A-Za-z0-9_-]{8,160}$" },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,160}$" },
    "versionId": { "type": "string", "pattern": "^ver_\\d{4,}$" },
    "versionOrdinal": { "type": "integer", "minimum": 2 },
    "candidateOutputSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "basedOnVersionId": { "type": "string", "pattern": "^ver_\\d{4,}$" },
    "previousVersionId": { "type": "string", "pattern": "^ver_\\d{4,}$" },
    "finalWorkingCopyRelativePath": {
      "type": "string",
      "pattern": "^(?!.*[/\\\\\\u0000-\\u001F]).+\\.(?:html|htm)$"
    },
    "preparedWorkingCopyRelativePath": {
      "type": "string",
      "pattern": "^transactions/promote_candidate_[A-Za-z0-9_-]{8,160}/prepared-working-copy\\.(?:html|htm)$"
    },
    "publicationWorkingCopyGuardRelativePath": {
      "type": "string",
      "pattern": "^transactions/promote_candidate_[A-Za-z0-9_-]{8,160}/publication-working-copy-guard\\.(?:html|htm)$"
    },
    "publicationWorkingCopyReplacementRelativePath": {
      "type": "string",
      "pattern": "^transactions/promote_candidate_[A-Za-z0-9_-]{8,160}/publication-working-copy-replacement\\.(?:html|htm)$"
    },
    "preferredFileStem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?!.*[\\u0000-\\u001F\\u007F/\\\\]).+$"
    },
    "preferredExtension": { "enum": [".html", ".htm"] },
    "pathAllocationOrdinal": { "type": "integer", "minimum": 0 },
    "preparedWorkingCopyFileIdentity": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["device", "inode", "birthtimeMs"],
      "properties": {
        "device": { "type": "string" },
        "inode": { "type": "string" },
        "birthtimeMs": { "type": "number", "minimum": 0 }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "snapshotCreatedAt": { "type": "string", "format": "date-time" },
    "reallocatedAt": { "type": "string", "format": "date-time" },
    "workingCopyPreparedAt": { "type": "string", "format": "date-time" },
    "workingCopyCreatedAt": { "type": "string", "format": "date-time" },
    "workingCopyStagedAt": { "type": "string", "format": "date-time" },
    "workingCopyPublishedAt": { "type": "string", "format": "date-time" },
    "manifestCommittedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "workingCopy": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "workingCopyId",
        "versionId",
        "basedOnVersionId",
        "sourceRelativePath",
        "preferredFileStem",
        "preferredExtension",
        "stateRelativePath",
        "fileIdentity"
      ],
      "properties": {
        "workingCopyId": { "type": "string", "pattern": "^work_ver_\\d{4,}$" },
        "versionId": { "type": "string", "pattern": "^ver_\\d{4,}$" },
        "basedOnVersionId": { "type": "string", "pattern": "^ver_\\d{4,}$" },
        "sourceRelativePath": {
          "type": "string",
          "pattern": "^(?!.*[/\\\\\\u0000-\\u001F]).+\\.(?:html|htm)$"
        },
        "preferredFileStem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?!.*[\\u0000-\\u001F\\u007F/\\\\]).+$"
        },
        "preferredExtension": { "enum": [".html", ".htm"] },
        "stateRelativePath": {
          "type": "string",
          "pattern": "^working-copies/work_ver_\\d{4,}\\.json$"
        },
        "fileIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["device", "inode", "birthtimeMs"],
          "properties": {
            "device": { "type": "string" },
            "inode": { "type": "string" },
            "birthtimeMs": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  }
}
