{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pageroot.local/schemas/project-registry.v4.schema.json",
  "$comment": "Forward compatible. A Registry whose required members are missing or invalid is still an unrecognized shape and still fails closed. A Registry that carries every required member plus a member added by a newer PageRoot is read normally, and that member is preserved unchanged through the next Registry write.",
  "type": "object",
  "required": ["schemaVersion", "updatedAt", "projects", "pendingImports"],
  "properties": {
    "schemaVersion": { "const": "4.0.0" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "projects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["registeredProjectRootPath", "rootFileIdentity", "updatedAt"],
        "dependentRequired": {
          "importSourceKey": ["importSourceSha256"],
          "importSourceSha256": ["importSourceKey"]
        },
        "properties": {
          "registeredProjectRootPath": { "type": "string", "pattern": "^(?:/|[A-Za-z]:[\\\\/])" },
          "rootFileIdentity": {
            "type": "object",
            "required": ["device", "inode", "birthtimeMs"],
            "properties": {
              "device": { "type": "string" },
              "inode": { "type": "string" },
              "birthtimeMs": { "type": "number", "minimum": 0 }
            }
          },
          "updatedAt": { "type": "string", "format": "date-time" },
          "importSourceKey": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "importSourceSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      },
      "propertyNames": { "pattern": "^project_[a-f0-9]{16,64}$" }
    },
    "pendingImports": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["projectId", "documentId", "registeredProjectRootPath", "createdAt"],
        "dependentRequired": {
          "importSourceKey": ["importSourceSha256"],
          "importSourceSha256": ["importSourceKey"]
        },
        "properties": {
          "projectId": { "type": "string", "pattern": "^project_[a-f0-9]{16,64}$" },
          "documentId": { "type": "string", "pattern": "^doc_[a-f0-9]{16,64}$" },
          "registeredProjectRootPath": { "type": "string", "pattern": "^(?:/|[A-Za-z]:[\\\\/])" },
          "createdAt": { "type": "string", "format": "date-time" },
          "importSourceKey": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "importSourceSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      },
      "propertyNames": { "pattern": "^project_[a-f0-9]{16,64}$" }
    }
  }
}
