{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://html-change.local/schemas/version-transaction.v1.schema.json",
  "title": "HTML AI two-phase Version transaction v1",
  "description": "A durable journal for preserving the prior source, publishing a non-overwriting active working copy, and aligning the immutable Version snapshot, commit marker, registry and project cache.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "transactionId",
    "state",
    "projectId",
    "documentId",
    "requestId",
    "attemptId",
    "basedOnVersionId",
    "previousVersionId",
    "candidateVersionId",
    "candidateVersionOrdinal",
    "candidateVersionLabel",
    "baseSnapshotSha256",
    "expectedSourceSha256",
    "candidateContentSha256",
    "candidateManifestSha256",
    "completionSha256",
    "completionRelativePath",
    "paths",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "transactionId": {
      "$ref": "#/$defs/transactionId"
    },
    "state": {
      "enum": [
        "preparing",
        "prepared",
        "source-applied",
        "version-published",
        "committed",
        "ready-to-open",
        "cache-rebuilt",
        "awaiting-conflict-resolution",
        "rolled-back",
        "external-kept",
        "aborted"
      ]
    },
    "projectId": {
      "$ref": "#/$defs/projectId"
    },
    "documentId": {
      "$ref": "#/$defs/documentId"
    },
    "requestId": {
      "$ref": "#/$defs/requestId"
    },
    "attemptId": {
      "$ref": "#/$defs/attemptId"
    },
    "basedOnVersionId": {
      "$ref": "#/$defs/versionId"
    },
    "previousVersionId": {
      "$ref": "#/$defs/versionId"
    },
    "candidateVersionId": {
      "$ref": "#/$defs/versionId"
    },
    "candidateVersionOrdinal": {
      "type": "integer",
      "minimum": 2
    },
    "candidateVersionLabel": {
      "type": "string",
      "pattern": "^V[1-9][0-9]*$"
    },
    "workingCopyStem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^\\u0000-\\u001F\\u007F/\\\\]+$",
      "description": "Sanitized original project-name stem retained in generated working-copy filenames. Absent only for legacy in-flight transactions."
    },
    "previousSourcePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Editable HTML path frozen at handoff. A successful AI transaction preserves this file byte-for-byte and activates a new working copy."
    },
    "expectedSourceSha256": {
      "$ref": "#/$defs/sha256"
    },
    "baseSnapshotSha256": {
      "$ref": "#/$defs/sha256",
      "description": "Immutable hash of the HTML frozen for the AI. Unlike expectedSourceSha256, this value never changes when a user explicitly adopts the AI result over an externally changed source."
    },
    "candidateContentSha256": {
      "$ref": "#/$defs/sha256"
    },
    "candidateManifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "pendingCandidateManifestSha256": {
      "$ref": "#/$defs/sha256",
      "description": "Crash-recovery intent for atomically resealing version.json with the successful commit timestamp."
    },
    "pendingVersionGeneratedAt": {
      "$ref": "#/$defs/timestamp",
      "description": "Generation timestamp paired with pendingCandidateManifestSha256 while the manifest reseal is in flight."
    },
    "versionGeneratedAt": {
      "$ref": "#/$defs/timestamp",
      "description": "The timestamp sealed into version.json and committed.json at the successful Version commit point."
    },
    "completionSha256": {
      "$ref": "#/$defs/sha256"
    },
    "outputRelativePath": {
      "type": "string",
      "pattern": "^requests/req_[A-Za-z0-9_-]+/attempts/attempt_[0-9]{3}/output/(?:index\\.html|(?:V1\\.[0-9]+|[^/\\\\]+-V1\\.[0-9]+)\\.html)$",
      "description": "Frozen Attempt output path retained for transaction recovery. Absent only for legacy in-flight transactions."
    },
    "completionRelativePath": {
      "type": "string",
      "pattern": "^requests/req_[A-Za-z0-9_-]+/attempts/attempt_[0-9]{3}/completion\\.json$"
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preparedVersionRelativePath",
        "recoverySourceRelativePath",
        "publishedVersionRelativePath",
        "commitMarkerRelativePath"
      ],
      "properties": {
        "preparedVersionRelativePath": {
          "type": "string",
          "pattern": "^transactions/txn_[A-Za-z0-9_-]+/prepared-version$"
        },
        "recoverySourceRelativePath": {
          "type": "string",
          "pattern": "^transactions/txn_[A-Za-z0-9_-]+/recovery/source\\.html$"
        },
        "publishedVersionRelativePath": {
          "type": "string",
          "pattern": "^versions/ver_[0-9]{4,}$"
        },
        "commitMarkerRelativePath": {
          "type": "string",
          "pattern": "^versions/ver_[0-9]{4,}/committed\\.json$"
        },
        "activeWorkingCopyRelativePath": {
          "type": "string",
          "pattern": "^working/(?:V1\\.[0-9]+|[^\\u0000-\\u001F\\u007F/\\\\]+-V1\\.[0-9]+)\\.html$",
          "description": "Non-overwriting editable copy activated only after the AI Version commits."
        }
      }
    },
    "recoverySourceSha256": {
      "$ref": "#/$defs/sha256"
    },
    "observedSourceSha256": {
      "$ref": "#/$defs/sha256"
    },
    "conflictDetectedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "confirmedExternalSha256": {
      "$ref": "#/$defs/sha256"
    },
    "conflictConfirmedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "sourceAppliedAt": {
      "$ref": "#/$defs/timestamp",
      "description": "Time the complete candidate was published at its non-overwriting semantic working-copy path. The historical field name is retained for v1 transaction compatibility."
    },
    "sourceActivatedAt": {
      "$ref": "#/$defs/timestamp",
      "description": "Time the project registry and project cache were redirected to the generated working copy."
    },
    "preparedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "versionPublishedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "committedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "readyToOpenAt": {
      "$ref": "#/$defs/timestamp",
      "description": "Time the committed Version became available for explicit user activation."
    },
    "cacheRebuiltAt": {
      "$ref": "#/$defs/timestamp"
    },
    "abortedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "abortReason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "terminalSourceSha256": {
      "$ref": "#/$defs/sha256"
    },
    "commitMarkerAbsentVerified": {
      "const": true
    },
    "rolledBackAt": {
      "$ref": "#/$defs/timestamp"
    },
    "resolvedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    },
    "updatedAt": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "pendingCandidateManifestSha256"
            ]
          },
          {
            "required": [
              "pendingVersionGeneratedAt"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "pendingCandidateManifestSha256",
          "pendingVersionGeneratedAt"
        ],
        "properties": {
          "state": {
            "const": "version-published"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "prepared",
              "source-applied",
              "version-published",
              "committed",
              "ready-to-open",
              "cache-rebuilt"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "recoverySourceSha256",
          "preparedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "rolled-back"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "terminalSourceSha256",
          "commitMarkerAbsentVerified",
          "rolledBackAt"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "committedAt"
              ]
            },
            {
              "required": [
                "cacheRebuiltAt"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "external-kept"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "terminalSourceSha256",
          "commitMarkerAbsentVerified",
          "resolvedAt"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "committedAt"
              ]
            },
            {
              "required": [
                "cacheRebuiltAt"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "source-applied",
              "version-published",
              "committed",
              "ready-to-open",
              "cache-rebuilt"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "sourceAppliedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "version-published",
              "committed",
              "ready-to-open",
              "cache-rebuilt"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "versionPublishedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "committed",
              "ready-to-open",
              "cache-rebuilt"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "committedAt",
          "versionGeneratedAt"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "pendingCandidateManifestSha256"
              ]
            },
            {
              "required": [
                "pendingVersionGeneratedAt"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "ready-to-open"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "readyToOpenAt"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "sourceActivatedAt"
              ]
            },
            {
              "required": [
                "cacheRebuiltAt"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "cache-rebuilt"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "cacheRebuiltAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "awaiting-conflict-resolution"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "observedSourceSha256",
          "conflictDetectedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "aborted"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "abortedAt",
          "abortReason"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "sourceAppliedAt"
              ]
            },
            {
              "required": [
                "versionPublishedAt"
              ]
            },
            {
              "required": [
                "committedAt"
              ]
            },
            {
              "required": [
                "cacheRebuiltAt"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "preparing",
              "prepared"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "sourceAppliedAt"
              ]
            },
            {
              "required": [
                "versionPublishedAt"
              ]
            },
            {
              "required": [
                "committedAt"
              ]
            },
            {
              "required": [
                "cacheRebuiltAt"
              ]
            }
          ]
        }
      }
    }
  ],
  "dependentRequired": {
    "confirmedExternalSha256": [
      "conflictConfirmedAt"
    ],
    "conflictConfirmedAt": [
      "confirmedExternalSha256"
    ]
  },
  "$defs": {
    "transactionId": {
      "type": "string",
      "pattern": "^txn_[A-Za-z0-9_-]+$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^project_[A-Za-z0-9_-]+$"
    },
    "documentId": {
      "type": "string",
      "pattern": "^doc_[A-Za-z0-9_-]+$"
    },
    "requestId": {
      "type": "string",
      "pattern": "^req_[A-Za-z0-9_-]+$"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^attempt_[0-9]{3}$"
    },
    "versionId": {
      "type": "string",
      "pattern": "^ver_[0-9]{4,}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!\\.\\.?$)(?!\\.\\.?/)(?!.*\\/\\.\\.?\\/)(?!.*\\/\\.\\.?$)[^\\u0000\\r\\n]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
