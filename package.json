{
  "name": "pageroot",
  "version": "0.9.8",
  "description": "源页（PageRoot）— Editable islands with byte-exact source outside every edited region.",
  "author": "源页",
  "license": "Apache-2.0",
  "private": true,
  "homepage": "https://github.com/Charleyli925/PageRoot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Charleyli925/PageRoot.git"
  },
  "bugs": {
    "url": "https://github.com/Charleyli925/PageRoot/issues"
  },
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log node scripts/dev.mjs",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "desktop:renderer": "vite build --config desktop/vite.config.ts",
    "desktop:dev": "npm run desktop:renderer && electron desktop/main.mjs",
    "desktop:pack": "npm run desktop:renderer && npm run desktop:pack:prepared",
    "desktop:pack:prepared": "node scripts/build-package.mjs --arch arm64",
    "desktop:pack:x64": "npm run desktop:renderer && npm run desktop:pack:x64:prepared",
    "desktop:pack:x64:prepared": "node scripts/build-package.mjs --arch x64",
    "ci:source-build": "npm run audit:dependencies && npm run ci:source-build:prepared",
    "ci:source-build:prepared": "npm run typecheck && npm run lint && npm run build",
    "architecture:check": "node scripts/check-architecture.mjs",
    "typecheck": "npm run architecture:check && tsc --noEmit",
    "test": "npm run test:node:full",
    "test:node:core": "node scripts/test-node-group.mjs core",
    "test:node:core:prepared": "node scripts/test-node-group.mjs core",
    "test:node:smoke": "node scripts/test-node-group.mjs smoke",
    "test:node:smoke:prepared": "node scripts/test-node-group.mjs smoke",
    "test:contract": "node scripts/test-node-group.mjs contract",
    "test:contract:prepared": "node scripts/test-node-group.mjs contract",
    "test:node:integration": "npm run build && npm run test:node:integration:prepared",
    "test:node:integration:prepared": "node scripts/test-node-group.mjs integration",
    "test:node:full": "npm run build && npm run test:node:full:prepared",
    "test:node:full:prepared": "node scripts/test-node-group.mjs full",
    "test:native": "npm run test:node:core",
    "test:browser": "npm run test:browser:full",
    "test:browser:smoke": "npm run build && npm run test:browser:smoke:prepared",
    "test:browser:smoke:prepared": "playwright test --config tests/e2e/browser/playwright.smoke.config.mjs",
    "test:browser:full": "npm run build && npm run test:browser:full:prepared",
    "test:browser:full:prepared": "playwright test --config tests/e2e/browser/playwright.config.mjs",
    "test:real-html": "npm run build && npm run test:real-html:prepared",
    "test:real-html:prepared": "playwright test --config tests/e2e/browser/playwright.real-html.config.mjs",
    "test:electron-editing": "npm run test:electron:full",
    "test:electron:smoke": "npm run desktop:renderer && npm run test:electron:smoke:prepared",
    "test:electron:smoke:prepared": "playwright test --config tests/e2e/electron/playwright.smoke.config.mjs",
    "test:electron:ci-preflight:prepared": "playwright test --config tests/e2e/electron/playwright.ci-preflight.config.mjs",
    "test:electron:full": "npm run desktop:renderer && npm run test:electron:full:prepared",
    "test:electron:full:prepared": "playwright test --config tests/e2e/electron/playwright.config.mjs",
    "test:ai-closed-loop:smoke": "npm run desktop:renderer && npm run test:ai-closed-loop:smoke:prepared",
    "test:ai-closed-loop:smoke:prepared": "playwright test --config tests/e2e/electron/playwright.ai-smoke.config.mjs",
    "test:ai-closed-loop": "npm run desktop:renderer && npm run test:ai-closed-loop:prepared",
    "test:ai-closed-loop:prepared": "playwright test --config tests/e2e/electron/playwright.ai-closed-loop.config.mjs",
    "test:packaged-runtime:prepared": "playwright test --config tests/e2e/electron/playwright.packaged.config.mjs",
    "test:packaged-startup:prepared": "playwright test --config tests/e2e/electron/playwright.packaged-startup.config.mjs",
    "test:bridge": "node --test tests/workspace-bridge.test.mjs",
    "benchmark:review-analysis": "node scripts/benchmark-review-analysis.mjs",
    "benchmark:persistence": "npm run desktop:renderer && node scripts/benchmark-persistence.mjs",
    "test:package": "node scripts/test-node-group.mjs package",
    "verify:packaged": "node scripts/verify-packaged-artifact.mjs --arch arm64",
    "verify:packaged:x64": "node scripts/verify-packaged-artifact.mjs --arch x64",
    "release:assets": "node scripts/create-release-assets.mjs",
    "audit:dependencies": "node scripts/check-dependency-audit.mjs",
    "pr:candidate": "node scripts/classify-pr-candidate.mjs",
    "review:policy": "node scripts/check-pr-review-policy.mjs",
    "review:debt": "node scripts/review-debt.mjs sync",
    "ci:health": "node scripts/ci-health-report.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-desktop --ignore-pattern release --ignore-pattern .next",
    "task:status": "node scripts/task-workflow.mjs status",
    "task:start": "node scripts/task-workflow.mjs start",
    "task:attach": "node scripts/task-workflow.mjs attach",
    "task:finish": "node scripts/task-workflow.mjs finish",
    "task:audit": "node scripts/task-workflow.mjs audit",
    "task:retire": "node scripts/task-workflow.mjs retire",
    "task:sync-main": "node scripts/task-workflow.mjs sync-main",
    "task:policy": "node scripts/task-workflow.mjs policy",
    "gate:edit": "node scripts/test-gate.mjs edit",
    "gate:task": "node scripts/test-gate.mjs task",
    "gate:main:auto": "node scripts/test-gate.mjs main",
    "gate:release:auto": "node scripts/test-gate.mjs release",
    "gate:developer-package": "node scripts/test-gate.mjs developer-package --arch arm64",
    "gate:developer-package:x64": "node scripts/test-gate.mjs developer-package --arch x64",
    "gate:candidate-app:auto": "node scripts/test-gate.mjs candidate-app --arch arm64",
    "gate:artifact-only:auto": "node scripts/test-gate.mjs artifact-only --arch arm64",
    "gate:artifact-only:auto:x64": "node scripts/test-gate.mjs artifact-only --arch x64",
    "gate:artifact:auto": "node scripts/test-gate.mjs artifact --arch arm64",
    "gate:artifact:auto:x64": "node scripts/test-gate.mjs artifact --arch x64",
    "verify": "npm run gate:task",
    "package:developer": "npm run gate:developer-package",
    "package:developer:x64": "npm run gate:developer-package:x64",
    "release:mac": "npm run gate:artifact:auto",
    "release:mac:x64": "npm run gate:artifact:auto:x64"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "@phosphor-icons/react": "2.1.10",
    "electron-updater": "6.8.9",
    "entities": "8.0.0",
    "next": "16.3.0",
    "parse5": "8.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "semver": "7.7.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@electron/notarize": "2.5.0",
    "@electron/osx-sign": "1.3.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.32",
    "app-builder-lib": "26.15.3",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.61.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "temp-file": "3.4.0",
    "typescript": "5.9.3",
    "vinext": "0.0.45",
    "vite": "8.2.0",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25"
    },
    "postcss": "8.5.25",
    "fast-uri": "3.1.5",
    "miniflare": {
      "undici": "7.29.0"
    },
    "nanoid": "3.3.17",
    "node-gyp": {
      "undici": "6.28.0"
    },
    "tar": "7.5.22"
  },
  "type": "module",
  "build": {
    "appId": "com.htmlai.workbench",
    "productName": "PageRoot",
    "artifactName": "PageRoot-${version}-${arch}.${ext}",
    "afterPack": "desktop/after-pack.mjs",
    "asar": true,
    "forceCodeSigning": true,
    "fileAssociations": [
      {
        "ext": [
          "html",
          "htm"
        ],
        "name": "HTML Document",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "desktop/resources"
    },
    "files": [
      "desktop/main.mjs",
      "desktop/preload.mjs",
      "desktop/external-file-open.mjs",
      "desktop/project-open-queue.mjs",
      "desktop/project-files.mjs",
      "desktop/source-rename.mjs",
      "desktop/project-path-policy.mjs",
      "desktop/welcome-project-content.mjs",
      "desktop/export-copy.mjs",
      "desktop/open-in-default-browser.mjs",
      "desktop/project-ipc-security.mjs",
      "desktop/bridge-startup.mjs",
      "desktop/bridge-shutdown.mjs",
      "desktop/close-recovery.mjs",
      "desktop/product-contract.mjs",
      "desktop/qoder-handoff.mjs",
      "desktop/product-links.mjs",
      "desktop/application-update.mjs",
      "desktop/usage-telemetry.mjs",
      "desktop/preview-protocol.mjs",
      "desktop/runtime-visual-capture-owner.mjs",
      "app/domain/runtime-visual-contract.js",
      "public/brand-logo.png",
      "dist-desktop/renderer/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "scripts/workspace-bridge.mjs",
        "to": "bridge/workspace-bridge.mjs"
      },
      {
        "from": "scripts/finalize-attempt.mjs",
        "to": "bridge/finalize-attempt.mjs"
      },
      {
        "from": "scripts/lifecycle-core.mjs",
        "to": "bridge/lifecycle-core.mjs"
      },
      {
        "from": "scripts/project-file-repository.mjs",
        "to": "bridge/project-file-repository.mjs"
      },
      {
        "from": "scripts/project-file-finalizer.mjs",
        "to": "bridge/project-file-finalizer.mjs"
      },
      {
        "from": "scripts/user-supplement-core.mjs",
        "to": "bridge/user-supplement-core.mjs"
      },
      {
        "from": "scripts/record-user-supplement.mjs",
        "to": "bridge/record-user-supplement.mjs"
      },
    {
      "from": "scripts/html-source-parser.mjs",
      "to": "bridge/html-source-parser.mjs"
    },
    {
      "from": "scripts/candidate-assessment.mjs",
      "to": "bridge/candidate-assessment.mjs"
    },
    {
      "from": "scripts/candidate-assessment-decoder.mjs",
      "to": "bridge/candidate-assessment-decoder.mjs"
    },
      {
        "from": "scripts/scope-validator.mjs",
        "to": "bridge/scope-validator.mjs"
      },
      {
        "from": "scripts/target-identity.mjs",
        "to": "bridge/target-identity.mjs"
      },
      {
        "from": "scripts/product-contract.mjs",
        "to": "bridge/product-contract.mjs"
      },
      {
        "from": "scripts/attachment-storage.mjs",
        "to": "bridge/attachment-storage.mjs"
      },
      {
        "from": "scripts/draft-aggregate.mjs",
        "to": "bridge/draft-aggregate.mjs"
      },
      {
        "from": "scripts/draft-service.mjs",
        "to": "bridge/draft-service.mjs"
      },
      {
        "from": "scripts/draft-command-decoder.mjs",
        "to": "bridge/draft-command-decoder.mjs"
      },
      {
        "from": "scripts/source-history-service.mjs",
        "to": "bridge/source-history-service.mjs"
      },
      {
        "from": "scripts/source-transaction-service.mjs",
        "to": "bridge/source-transaction-service.mjs"
      },
      {
        "from": "scripts/project-context-service.mjs",
        "to": "bridge/project-context-service.mjs"
      },
      {
        "from": "shared/draft-aggregate.mjs",
        "to": "shared/draft-aggregate.mjs"
      },
      {
        "from": "shared/direct-edit-compatibility.mjs",
        "to": "shared/direct-edit-compatibility.mjs"
      },
      {
        "from": "shared/source-history.mjs",
        "to": "shared/source-history.mjs"
      },
      {
        "from": "node_modules/parse5",
        "to": "node_modules/parse5",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/entities",
        "to": "node_modules/entities",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/electron-updater",
        "to": "node_modules/electron-updater",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/builder-util-runtime",
        "to": "node_modules/builder-util-runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/fs-extra",
        "to": "node_modules/fs-extra",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/js-yaml",
        "to": "node_modules/js-yaml",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/lazy-val",
        "to": "node_modules/lazy-val",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/lodash.escaperegexp",
        "to": "node_modules/lodash.escaperegexp",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/lodash.isequal",
        "to": "node_modules/lodash.isequal",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/semver",
        "to": "node_modules/semver",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/tiny-typed-emitter",
        "to": "node_modules/tiny-typed-emitter",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/debug",
        "to": "node_modules/debug",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/sax",
        "to": "node_modules/sax",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/ms",
        "to": "node_modules/ms",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/argparse",
        "to": "node_modules/argparse",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/graceful-fs",
        "to": "node_modules/graceful-fs",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/jsonfile",
        "to": "node_modules/jsonfile",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/universalify",
        "to": "node_modules/universalify",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "schemas",
        "to": "schemas",
        "filter": [
          "annotation-records.v3.schema.json",
          "attempt-outcome.v1.schema.json",
          "candidate-assessment.v1.schema.json",
          "candidate.v4.schema.json",
          "change-request.v3.schema.json",
          "committed-marker.v1.schema.json",
          "completion.v1.schema.json",
          "input-manifest.v1.schema.json",
          "project-state.v3.schema.json",
          "project-identity.v4.schema.json",
          "project-registry.v4.schema.json",
          "project-manifest.v4.schema.json",
          "project-runtime-state.v4.schema.json",
          "promotion-transaction.v4.schema.json",
          "runtime-state.v3.schema.json",
          "scope-report.v1.schema.json",
          "source-history.v1.schema.json",
          "user-supplement.v1.schema.json",
          "version-manifest.v3.schema.json",
          "version-transaction.v1.schema.json",
          "working-copy-state.v4.schema.json"
        ]
      },
      {
        "from": "output/release-metadata/build-info.json",
        "to": "build-info.json"
      },
      {
        "from": "output/release-metadata/app-update.yml",
        "to": "app-update.yml"
      },
      {
        "from": "PageRoot 用户声明与免责声明.txt",
        "to": "PageRoot 用户声明与免责声明.txt"
      },
      {
        "from": "output/release-metadata/usage-telemetry-config.json",
        "to": "usage-telemetry-config.json"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "PRIVACY.md",
        "to": "PRIVACY.md"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "desktop/resources/icon.icns",
      "hardenedRuntime": true,
      "notarize": true,
      "entitlements": "desktop/resources/entitlements.mac.plist",
      "entitlementsInherit": "desktop/resources/entitlements.mac.plist",
      "electronUpdaterCompatibility": ">=2.16",
      "minimumSystemVersion": "12.0",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Charleyli925",
        "repo": "PageRoot",
        "releaseType": "release"
      }
    ],
    "dmg": {
      "title": "PageRoot ${version}",
      "backgroundColor": "#f2f0ea",
      "window": {
        "width": 660,
        "height": 430
      },
      "contents": [
        {
          "x": 170,
          "y": 210,
          "type": "file"
        },
        {
          "x": 490,
          "y": 210,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 330,
          "y": 350,
          "type": "file",
          "path": "desktop/resources/首次打开说明.txt"
        }
      ]
    }
  }
}
