# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
._*
Thumbs.db
*.pem
*.key
*.p12
*.pfx
*.mobileprovision

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/dist-desktop/
/output/
/release/
/.playwright-cli/
# Playwright writes failure traces and its last-run marker here. It is generated
# evidence, not source, and must never reach a commit.
/test-results/
*.tsbuildinfo
/.wrangler/
/outputs/
/work/

# local IDE and scratch files
/.idea/
/.vscode/
*.swp
*.swo
*.orig

# local release credentials and notarization material
*.cer
*.provisionprofile

# isolated task checkouts created by `npm run task:start`
.codex-worktrees/
