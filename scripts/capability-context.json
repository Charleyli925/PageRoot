{
  "schemaVersion": 2,
  "defaultLevel": "contract",
  "domains": [
    {
      "id": "comments",
      "patterns": [
        "^app/application/comment(?:-workflow|-session|-workflow-codecs)?",
        "^app/application/comment/",
        "^app/workbench/comment-(?:rail|canvas)",
        "^tests/comment-"
      ],
      "entryInterfaces": [
        "app/application/comment-workflow.d.ts",
        "app/application/comment-session.d.ts",
        "app/application/workspace-controller-capabilities.d.ts",
        "app/workbench/comment-canvas-port.d.ts",
        "app/workbench/comment-rail-contract.ts",
        "app/application/comment/commit-plan.d.ts"
      ],
      "owners": [
        "CommentSession",
        "CommentWorkflow"
      ],
      "implementationFiles": [
        "app/application/comment-workflow.js",
        "app/application/comment-session.js",
        "app/application/comment/commit-plan.js",
        "app/workbench/comment-canvas-port.js",
        "app/workbench/comment-rail-container.tsx",
        "app/workbench/comment-rail-contract.ts",
        "app/workbench/comment-rail-state.js",
        "app/workbench/comment-rail-view.tsx"
      ],
      "focusedTests": [
        "tests/comment-workflow.test.mjs",
        "tests/comment-commit-plan.test.mjs",
        "tests/comment-session.test.mjs",
        "tests/comment-canvas-port.test.mjs",
        "tests/workbench-render-snapshot.test.mjs"
      ],
      "requiredDocs": [
        "docs/ARCHITECTURE_MAP.md",
        "docs/ARCHITECTURE_CONTRACT.md",
        "docs/GUARD_LEDGER.md"
      ]
    },
    {
      "id": "document-save",
      "patterns": [
        "^app/application/document-workflow",
        "^app/application/document/",
        "^app/application/verified-project-context",
        "^app/application/document-session",
        "^tests/document-"
      ],
      "entryInterfaces": [
        "app/application/document-workflow.d.ts",
        "app/application/document-session.d.ts",
        "app/application/document/save-plan.d.ts",
        "app/application/verified-project-context.d.ts",
        "app/application/workspace-controller-capabilities.d.ts"
      ],
      "owners": [
        "DocumentSession",
        "DocumentWorkflow"
      ],
      "implementationFiles": [
        "app/application/document-workflow.js",
        "app/application/document-session.js",
        "app/application/document/save-plan.js",
        "app/application/verified-project-context.js"
      ],
      "focusedTests": [
        "tests/document-workflow.test.mjs",
        "tests/document-save-plan.test.mjs",
        "tests/document-session.test.mjs"
      ],
      "requiredDocs": [
        "docs/ARCHITECTURE_MAP.md",
        "docs/ARCHITECTURE_CONTRACT.md"
      ]
    },
    {
      "id": "project-lifecycle",
      "patterns": [
        "^app/application/project-workflow",
        "^app/application/project-session",
        "^app/application/project/",
        "^app/application/project-application-session",
        "^app/application/external-file-open",
        "^tests/project-",
        "^tests/external-file-open",
        "^tests/desktop-close-recovery"
      ],
      "entryInterfaces": [
        "app/application/project-workflow.d.ts",
        "app/application/project-session.d.ts",
        "app/application/project/open-intent.d.ts",
        "app/application/project/switch-plan.d.ts",
        "app/application/project/close-plan.d.ts",
        "app/application/project/source-locator-plan.d.ts",
        "app/application/workspace-controller-capabilities.d.ts",
        "app/workbench/workbench-sidebar-container.tsx"
      ],
      "owners": [
        "ProjectSession",
        "ProjectWorkflow",
        "ProjectRulesWorkflow",
        "WorkbenchGlobalSidebarContainer"
      ],
      "implementationFiles": [
        "app/application/project-workflow.js",
        "app/application/project-session.js",
        "app/application/project/open-intent.js",
        "app/application/project/switch-plan.js",
        "app/application/project/close-plan.js",
        "app/application/project/source-locator-plan.js",
        "app/workbench/workbench-sidebar-container.tsx",
        "app/workbench/project-version-tree.tsx"
      ],
      "focusedTests": [
        "tests/project-workflow.test.mjs",
        "tests/project-plan.test.mjs",
        "tests/project-session.test.mjs",
        "tests/workbench-render-snapshot.test.mjs",
        "tests/workspace-controller.test.mjs"
      ],
      "requiredDocs": [
        "docs/ARCHITECTURE_MAP.md",
        "docs/INTERACTION_FLOW.md",
        "docs/GUARD_LEDGER.md"
      ]
    },
    {
      "id": "canvas-selection",
      "patterns": [
        "^app/components/html-canvas-selection-chrome",
        "^app/components/HtmlCanvasEditor",
        "^app/components/html-canvas-pointer-capability",
        "^tests/html-canvas-",
        "^tests/canvas-pointer"
      ],
      "entryInterfaces": [
        "app/components/html-canvas-selection-chrome-contract.ts",
        "app/components/HtmlCanvasEditor.types.ts",
        "app/application/edit-author-runtime-session.d.ts"
      ],
      "owners": [
        "EditAuthorRuntimeSession",
        "HtmlCanvasEditor"
      ],
      "implementationFiles": [
        "app/components/html-canvas-selection-chrome-contract.ts",
        "app/components/html-canvas-selection-chrome.tsx",
        "app/components/HtmlCanvasEditor.tsx"
      ],
      "focusedTests": [
        "tests/html-canvas-capability-hover.test.mjs",
        "tests/canvas-pointer-capability.test.mjs"
      ],
      "requiredDocs": [
        "docs/ARCHITECTURE_MAP.md",
        "docs/ENGINEERING_STANDARDS.md"
      ]
    },
    {
      "id": "run-and-review",
      "patterns": [
        "^app/application/run-workflow",
        "^app/application/run-session",
        "^app/application/version-workflow",
        "^app/application/version-session",
        "^app/workbench/AiReviewWorkspace",
        "^app/workbench/run-conversation-outlet",
        "^app/workbench/AiConversationSidebar",
        "^tests/run-",
        "^tests/version-"
      ],
      "entryInterfaces": [
        "app/application/run-workflow.d.ts",
        "app/application/run-session.d.ts",
        "app/application/version-workflow.d.ts",
        "app/application/version-session.d.ts",
        "app/application/run/submit-plan.d.ts",
        "app/application/version/review-plan.d.ts",
        "app/application/workspace-controller-capabilities.d.ts",
        "app/workbench/ai-conversation-model.d.ts"
      ],
      "owners": [
        "RunSession",
        "RunWorkflow",
        "VersionSession",
        "VersionWorkflow",
        "WorkspaceController runs capability",
        "RunConversationOutlet"
      ],
      "implementationFiles": [
        "app/application/run-workflow.js",
        "app/application/version-workflow.js",
        "app/application/run/submit-plan.js",
        "app/application/version/review-plan.js",
        "app/workbench/run-conversation-outlet.tsx",
        "app/workbench/AiConversationSidebar.tsx"
      ],
      "focusedTests": [
        "tests/run-workflow.test.mjs",
        "tests/version-workflow.test.mjs",
        "tests/run-submit-plan.test.mjs",
        "tests/version-review-plan.test.mjs",
        "tests/ai-conversation-sidebar.test.mjs",
        "tests/workbench-render-snapshot.test.mjs",
        "tests/workspace-controller.test.mjs"
      ],
      "requiredDocs": [
        "docs/ARCHITECTURE_MAP.md",
        "docs/CHANGE_REQUEST_PROTOCOL.md"
      ]
    },
    {
      "id": "navigation-tabs",
      "patterns": [
        "^app/application/workbench-navigation",
        "^app/application/workbench-tabs",
        "^app/application/browser-document",
        "^app/workbench/workbench-navigation-container",
        "^tests/workbench-navigation",
        "^tests/workbench-tabs"
      ],
      "entryInterfaces": [
        "app/application/workbench-navigation-workflow.d.ts",
        "app/application/workbench-navigation-session.d.ts",
        "app/application/workbench-tabs-session.d.ts",
        "app/application/workspace-controller-capabilities.d.ts"
      ],
      "owners": [
        "WorkbenchTabsSession",
        "WorkbenchNavigationSession",
        "WorkbenchNavigationWorkflow",
        "WorkspaceController navigation capability",
        "WorkbenchTabBarContainer"
      ],
      "implementationFiles": [
        "app/application/workbench-navigation-workflow.js",
        "app/workbench/workbench-navigation-container.tsx"
      ],
      "focusedTests": [
        "tests/workbench-navigation-workflow.test.mjs",
        "tests/workspace-controller.test.mjs"
      ],
      "requiredDocs": [
        "docs/ARCHITECTURE_MAP.md",
        "docs/INTERACTION_FLOW.md"
      ]
    },
    {
      "id": "workspace-controller-capabilities",
      "patterns": [
        "^app/application/workspace-controller(?:-capabilities)?\\.d\\.ts$",
        "^app/application/workbench-navigation-workflow\\.d\\.ts$",
        "^app/workbench/(?:ReviewAnalysisPrewarm|document-surface-presentation|use-ai-conversation)\\.(?:ts|tsx)$",
        "^tests/workspace-controller-capabilities\\.typecheck\\.ts$"
      ],
      "entryInterfaces": [
        "app/application/workspace-controller-capabilities.d.ts"
      ],
      "owners": [
        "WorkspaceController capability contracts"
      ],
      "implementationFiles": [
        "app/application/workspace-controller.d.ts",
        "app/application/workbench-navigation-workflow.d.ts",
        "app/workbench/ReviewAnalysisPrewarm.tsx",
        "app/workbench/document-surface-presentation.ts",
        "app/workbench/use-ai-conversation.ts"
      ],
      "focusedTests": [
        "tests/workspace-controller-capabilities.typecheck.ts",
        "tests/workbench-navigation-workflow.test.mjs",
        "tests/review-analysis-session.test.mjs"
      ],
      "requiredDocs": [
        "docs/CODEX_WORKFLOW.md"
      ]
    },
    {
      "id": "architecture-policy",
      "patterns": [
        "^docs/ARCHITECTURE",
        "^docs/GUARD_LEDGER",
        "^docs/ENGINEERING_STANDARDS",
        "^scripts/check-architecture",
        "^scripts/architecture-",
        "^scripts/capability-context",
        "^tests/architecture-boundaries"
      ],
      "entryInterfaces": [
        "docs/ARCHITECTURE_MAP.md",
        "scripts/check-architecture.mjs"
      ],
      "owners": [
        "architecture-gate"
      ],
      "implementationFiles": [
        "scripts/check-architecture.mjs",
        "scripts/capability-context.mjs",
        "scripts/capability-context.json"
      ],
      "focusedTests": [
        "tests/architecture-boundaries.test.mjs",
        "tests/test-gate-selection.test.mjs"
      ],
      "requiredDocs": [
        "docs/ARCHITECTURE_MAP.md",
        "docs/ARCHITECTURE_CONTRACT.md",
        "docs/GUARD_LEDGER.md",
        "docs/ENGINEERING_STANDARDS.md"
      ]
    }
  ]
}
