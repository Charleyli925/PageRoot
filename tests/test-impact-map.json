        "^\\.github/dependabot\\.yml$",
        "^scripts/check-dependency-audit\\.mjs$",
        "^tests/dependency-audit-policy\\.test\\.mjs$",
        "^docs/DEPENDENCY_SECURITY\\.md$"
      ],
      "suites": ["dependency-audit"],
      "nodeTests": ["tests/dependency-audit-policy.test.mjs"]
    },
    {
      "id": "packaging",
      "patterns": [
        "^(?:\\.github/workflows/release-candidate\\.yml|package(?:-lock)?\\.json|PageRoot 用户声明与免责声明\\.txt|desktop/after-pack\\.mjs|desktop/resources/.*|scripts/(?:build-package|create-release-assets|developer-preview|release-app-(?:checkpoint|stage)|release-candidate-provenance|release-provenance|source-gate-provenance|verify-packaged-artifact)\\.mjs)$"
      ],
      "suites": [],
      "nodeTests": [
        "tests/desktop-package.test.mjs",
        "tests/developer-preview-package.test.mjs",
        "tests/packaged-artifact-gate.test.mjs",
        "tests/release-app-stage.test.mjs",
