        "tests/usage-telemetry.test.mjs"
      ]
    },
    {
      "id": "desktop-ai-handoff",
      "patterns": ["^desktop/(?:main|qoder-handoff|product-contract)\\.mjs$"],
      "suites": ["ai-smoke"],
      "nodeTests": [
        "tests/qoder-handoff.test.mjs",
        "tests/product-contract.test.mjs"
      ]
    },
    {
      "id": "bridge-lifecycle",
      "patterns": [
        "^scripts/(?:workspace-bridge|lifecycle-core|finalize-attempt|record-user-supplement|user-supplement-core|scope-validator|html-source-parser|attachment-storage|draft-aggregate|draft-service|project-context-service|source-history-service|product-contract|target-identity)\\.mjs$"
      ],
      "suites": ["ai-smoke"],
      "nodeTests": [
        "tests/workspace-bridge.test.mjs",
        "tests/lifecycle-core.test.mjs",
        "tests/scope-validator.test.mjs",
        "tests/html-source-parser.test.mjs",
        "tests/attachment-storage.test.mjs",
        "tests/product-contract.test.mjs",
        "tests/project-context-service.test.mjs",
        "tests/targeted-change-schema.test.mjs",
        "tests/user-supplement.test.mjs"
      ]
    },
    {
      "id": "schemas",
      "patterns": [
        "^schemas/.*\\.json$",
        "^fixtures/v3/source-history\\.current\\.json$"
      ],
      "suites": [],
      "nodeTests": [
        "tests/schema-contract.test.mjs",
        "tests/targeted-change-schema.test.mjs",
        "tests/scope-validator.test.mjs",
        "tests/workspace-bridge.test.mjs"
      ]
    },
    {
      "id": "dependency-audit-policy",
      "patterns": [
