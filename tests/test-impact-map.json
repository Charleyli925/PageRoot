    {
      "id": "ai-e2e",
      "patterns": [
        "^tests/e2e/electron/ai-handoff-closed-loop\\.spec\\.mjs$",
        "^tests/e2e/electron/playwright\\.ai-(?:closed-loop|smoke)\\.config\\.mjs$",
