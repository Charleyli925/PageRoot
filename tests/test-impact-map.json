{
  "schemaVersion": 1,
  "suites": {
    "build-web": {
      "description": "Build the production web renderer once for Node render and browser gates.",
      "prerequisites": []
    },
    "build-desktop": {
      "description": "Build the Electron renderer once for desktop gates and packaging.",
      "prerequisites": []
    },
    "typecheck": {
      "description": "Run the TypeScript compiler without emitting files.",
      "prerequisites": []
    },
    "lint": {
      "description": "Run repository lint rules.",
      "prerequisites": []
    },
    "dependency-audit": {
      "description": "Reject unreviewed or expired npm security advisories.",
      "prerequisites": []
    },
    "node-targeted": {
      "description": "Run only the Node test files selected by the impact map.",
      "prerequisites": []
    },
    "node-core": {
      "description": "Run core logic and invariant Node tests, excluding source-string contracts and heavy integration gates.",
      "prerequisites": []
    },
    "node-contract": {
      "description": "Run implementation-shape contracts only when their owned UI or controller changes.",
      "prerequisites": []
    },
    "node-integration": {
      "description": "Run Bridge, filesystem, schema, lifecycle and rendered-output integration tests.",
      "prerequisites": ["build-web"]
    },
    "node-package": {
      "description": "Run package manifest and packaged-artifact verifier contracts.",
      "prerequisites": []
    },
    "node-smoke": {
      "description": "Run a fixed fast cross-section of source patch, scope and product-contract Node tests.",
      "prerequisites": []
    },
    "node-full": {
      "description": "Run every top-level Node test exactly once.",
      "prerequisites": ["build-web"]
    },
    "browser-smoke": {
      "description": "Run a small stable cross-section of V2 editable-island input, source-byte, formatting and history behavior.",
      "prerequisites": ["build-web"]
    },
    "browser-full": {
      "description": "Run the complete real Chromium editing suite with retries disabled.",
      "prerequisites": ["build-web"]
    },
    "real-html": {
      "description": "Run the discovery-based real-HTML island byte/geometry oracle and the opt-in all-host operation census.",
      "prerequisites": ["build-web"]
    },
    "electron-smoke": {
      "description": "Run stable real Electron authored-DOM and persisted-composition smoke tests.",
      "prerequisites": ["build-desktop"]
    },
    "electron-full": {
      "description": "Run the complete Electron editing suite, including disk persistence and cold reopen.",
      "prerequisites": ["build-desktop"]
    },
    "ai-closed-loop": {
      "description": "Run the deterministic Electron comment-to-AI finalizer closed loop and failure paths.",
      "prerequisites": ["build-desktop"]
    },
    "ai-smoke": {
      "description": "Run one successful deterministic AI loop and one out-of-scope fail-closed path.",
      "prerequisites": ["build-desktop"]
    },
    "package-build": {
      "description": "Build the requested macOS candidate without rebuilding the renderer.",
      "prerequisites": ["build-desktop"]
    },
    "developer-package-build": {
      "description": "Build one ad-hoc macOS developer preview DMG from the exact clean tree.",
      "prerequisites": ["build-desktop"]
    },
    "developer-packaged-verify": {
      "description": "Verify developer preview app.asar, Bridge resources, schemas, ad-hoc signature and DMG integrity.",
      "prerequisites": ["developer-package-build"]
    },
    "developer-packaged-startup": {
      "description": "Launch the developer preview with isolated data and prove version, first window, readiness and clean exit.",
      "prerequisites": ["developer-packaged-verify"]
    },
    "candidate-app-build": {
      "description": "Assemble the formal candidate app without Developer ID signing or Apple notarization.",
      "prerequisites": ["build-desktop"]
    },
    "candidate-app-verify": {
      "description": "Verify candidate app contents and dependency closure before release credentials are used.",
      "prerequisites": ["candidate-app-build"]
    },
    "candidate-app-runtime": {
      "description": "Run the full packaged runtime oracle against the verified pre-sign candidate app.",
      "prerequisites": ["candidate-app-verify"]
    },
    "packaged-runtime": {
      "description": "Launch the packaged .app with isolated data and verify source bytes, stale-draft reconciliation and clean close/reopen.",
      "prerequisites": ["package-build"]
    },
    "packaged-verify": {
      "description": "Verify app.asar, Bridge resources, schemas, signature, DMG integrity and read-only mount contents.",
      "prerequisites": ["package-build"]
    }
  },
  "lanes": {
    "edit": {
      "description": "Fast feedback while editing; only impacted Node tests and explicitly mapped compiler checks.",
      "allowedSuites": [
        "typecheck",
        "node-targeted",
        "node-core",
        "node-contract",
        "node-integration",
        "node-package"
      ],
      "alwaysForCode": []
    },
    "task": {
      "description": "End-of-task gate; adds static checks and impacted browser, Electron or AI smoke coverage.",
      "allowedSuites": [
        "typecheck",
        "lint",
        "dependency-audit",
        "node-targeted",
        "node-core",
        "node-contract",
        "node-integration",
        "node-package",
        "browser-smoke",
        "real-html",
        "electron-smoke",
        "ai-smoke"
      ],
      "alwaysForCode": ["typecheck", "lint"]
    },
    "main": {
      "description": "Fast post-merge smoke after the PR source-gate provenance has matched the exact main tree.",
      "fullSuites": [
        "node-smoke",
        "browser-smoke"
      ]
    },
    "release": {
      "description": "Fully automated pre-package release gate against one source state.",
      "fullSuites": [
        "typecheck",
        "lint",
        "dependency-audit",
        "node-full",
        "browser-full",
        "electron-full",
        "ai-closed-loop",
        "real-html"
      ]
    },
    "developer-package": {
      "description": "Optional on-demand developer preview from one clean committed source state.",
      "fullSuites": [
        "developer-packaged-startup"
      ]
    },
    "candidate-app": {
      "description": "Internal exact-tree pre-sign app gate used by the formal release candidate workflow.",
      "fullSuites": [
        "candidate-app-runtime"
      ]
    },
    "artifact": {
      "description": "Release gate plus package build, packaged runtime smoke and artifact verification.",
      "fullSuites": [
        "typecheck",
        "lint",
        "dependency-audit",
        "node-full",
        "browser-full",
        "electron-full",
        "ai-closed-loop",
        "real-html",
        "package-build",
        "packaged-runtime",
        "packaged-verify"
      ]
    },
    "artifact-only": {
      "description": "Build and verify the installer only after CI has authenticated a fresh source gate for the exact tree.",
      "fullSuites": [
        "package-build",
        "packaged-runtime",
        "packaged-verify"
      ]
    }
  },
  "rules": [
    {
      "id": "test-policy",
      "patterns": [
        "^scripts/test-(?:gate|node-group)(?:-core)?\\.mjs$",
        "^tests/test-impact-map\\.json$",
        "^tests/test-gate-selection\\.test\\.mjs$"
      ],
      "suites": [],
      "nodeTests": ["tests/test-gate-selection.test.mjs"]
    },
    {
      "id": "source-gate-provenance",
      "patterns": [
        "^scripts/source-gate-provenance\\.mjs$",
        "^tests/source-gate-provenance\\.test\\.mjs$",
        "^\\.github/workflows/(?:ci|developer-preview|release|release-candidate)\\.yml$"
      ],
      "suites": [],
      "nodeTests": ["tests/source-gate-provenance.test.mjs"]
    },
    {
      "id": "ci-evidence",
      "patterns": [
        "^scripts/ci-evidence\\.mjs$",
        "^tests/ci-evidence\\.test\\.mjs$",
        "^\\.github/workflows/(?:ci|developer-preview|release|release-candidate)\\.yml$"
      ],
      "suites": [],
      "nodeTests": ["tests/ci-evidence.test.mjs"]
    },
    {
      "id": "ci-health-report",
      "patterns": [
        "^scripts/ci-health-report\\.mjs$",
        "^tests/ci-health-report\\.test\\.mjs$",
        "^\\.github/workflows/ci-health\\.yml$"
      ],
      "suites": [],
      "nodeTests": ["tests/ci-health-report.test.mjs"]
    },
    {
      "id": "release-candidate-provenance",
      "patterns": [
        "^scripts/release-candidate-provenance\\.mjs$",
        "^tests/release-candidate-provenance\\.test\\.mjs$",
        "^\\.github/workflows/(?:release|release-candidate)\\.yml$"
      ],
      "suites": [],
      "nodeTests": ["tests/release-candidate-provenance.test.mjs"]
    },
    {
      "id": "task-workflow",
      "patterns": [
        "^\\.github/workflows/ci\\.yml$",
        "^AGENTS\\.md$",
        "^CONTRIBUTING\\.md$",
        "^docs/(?:CODEX_WORKFLOW|DEVELOPMENT|GIT_WORKFLOW)\\.md$",
        "^docs/decisions/0010-worktree-branch-lifecycle\\.md$",
        "^package\\.json$",
        "^scripts/task-workflow\\.mjs$",
        "^tests/task-workflow\\.test\\.mjs$"
      ],
      "suites": [],
      "nodeTests": ["tests/task-workflow.test.mjs"]
    },
    {
      "id": "state-architecture",
      "patterns": [
        "^app/application/(?:bridge-client|comment-session|document-session|draft-session|drain-coordinator|project-query-fence|project-rules-session|project-session|recovery-store|run-session|runtime-capabilities|source-history-session|version-session)\\.(?:js|d\\.ts)$",
        "^app/domain/(?:draft-aggregate|run-lifecycle|source-history)\\.(?:js|d\\.ts)$",
        "^shared/(?:draft-aggregate|source-history)\\.mjs$",
        "^scripts/(?:check-architecture|draft-aggregate|draft-service|project-context-service|source-history-service)\\.mjs$",
        "^tests/(?:architecture-boundaries|bridge-client|comment-session|document-session|draft-aggregate|draft-service|draft-session|drain-coordinator|project-query-fence|project-rules-session|project-session|recovery-store|run-lifecycle|run-session|runtime-capabilities|source-history|source-history-session|version-session)\\.test\\.mjs$",
        "^(?:CONTRIBUTING|docs/(?:ARCHITECTURE|ARCHITECTURE_CONTRACT|STATE_OWNERSHIP|ENGINEERING_STANDARDS))\\.md$",
        "^docs/decisions/(?:0003-session-ownership-and-mutation-outcomes|0004-v2-editable-islands|0007-independent-interactive-preview|0008-safe-presentation-actions-in-edit-mode|0009-persistent-source-patch-history|0011-workbench-session-decomposition|0012-id-first-project-context)\\.md$"
      ],
      "suites": ["typecheck"],
      "nodeTests": [
        "tests/architecture-boundaries.test.mjs",
        "tests/bridge-client.test.mjs",
        "tests/comment-session.test.mjs",
        "tests/document-session.test.mjs",
        "tests/draft-aggregate.test.mjs",
        "tests/draft-service.test.mjs",
        "tests/draft-session.test.mjs",
        "tests/drain-coordinator.test.mjs",
        "tests/project-query-fence.test.mjs",
        "tests/project-context-service.test.mjs",
        "tests/project-rules-session.test.mjs",
        "tests/project-session.test.mjs",
        "tests/recovery-store.test.mjs",
        "tests/run-lifecycle.test.mjs",
        "tests/run-session.test.mjs",
        "tests/runtime-capabilities.test.mjs",
        "tests/source-history.test.mjs",
        "tests/source-history-session.test.mjs",
        "tests/version-session.test.mjs"
      ]
    },
    {
      "id": "source-editing-core",
      "patterns": [
        "^app/lib/(?:canvas-target-rebind|editable-island|native-dom-logical-index|page-view-context|source-(?:index|patch-core|patch-engine|text-map)|target-resolver|runtime-dom-source-map|native-(?:edit-capability|edit-policy))\\.(?:js|ts|d\\.ts)$",
        "^scripts/(?:source-index|source-patch-engine|target-resolver)\\.mjs$"
      ],
      "suites": ["typecheck", "browser-smoke", "electron-smoke"],
      "nodeTests": [
        "tests/canvas-target-rebind.test.mjs",
        "tests/source-index-target-resolver.test.mjs",
        "tests/page-view-context.test.mjs",
        "tests/source-patch-engine.test.mjs",
        "tests/editable-island.test.mjs",
        "tests/source-text-map.test.mjs",
        "tests/runtime-dom-source-map.test.mjs",
        "tests/native-edit-capability.test.mjs",
        "tests/native-edit-policy.test.mjs",
        "tests/generated-source-invariants.test.mjs"
      ]
    },
    {
      "id": "v2-island-controller",
      "patterns": [
        "^app/components/(?:HtmlCanvasEditor(?:\\.types)?|html-canvas-(?:dom|interaction|internal-types|page-view|preview-sync|selection|style-inspector)|IslandEditingController|native-edit-types|native-edit-runtime-preflight|html-preview-sandbox)\\.(?:tsx|ts|js|d\\.ts)$"
      ],
      "suites": ["typecheck", "browser-smoke", "electron-smoke"],
      "nodeTests": [
        "tests/editable-island.test.mjs",
        "tests/runtime-dom-source-map.test.mjs",
        "tests/source-text-map.test.mjs",
        "tests/native-command-queue-contract.test.mjs",
        "tests/native-layout-guard.test.mjs",
        "tests/html-preview-sandbox.test.mjs",
        "tests/rendered-html.test.mjs",
        "tests/workbench-source-fence-contract.test.mjs"
      ]
    },
    {
      "id": "comment-rail-layout",
      "patterns": [
        "^app/lib/comment-rail-layout\\.js$",
        "^tests/comment-rail-layout\\.test\\.mjs$"
      ],
      "suites": ["typecheck", "browser-smoke"],
      "nodeTests": [
        "tests/comment-rail-layout.test.mjs",
        "tests/workbench-shell-ux.test.mjs"
      ]
    },
    {
      "id": "workbench-lifecycle",
      "patterns": [
        "^app/workbench(?:\\.tsx|/.*\\.(?:ts|tsx))$",
        "^app/lib/comment-rail-layout\\.js$",
        "^tests/(?:comment-rail-layout\\.test|source-architecture-fixture)\\.mjs$"
      ],
      "suites": ["typecheck", "browser-smoke", "electron-smoke", "ai-smoke"],
      "nodeTests": [
        "tests/direct-edit-events.test.mjs",
        "tests/comment-rail-layout.test.mjs",
        "tests/frontend-target-refresh.test.mjs",
        "tests/notification-policy.test.mjs",
        "tests/notification-ui.test.mjs",
        "tests/workbench-source-fence-contract.test.mjs",
        "tests/workbench-shell-ux.test.mjs"
      ]
    },
    {
      "id": "web-ui",
      "patterns": ["^app/(?:components/.*|page|layout)\\.(?:tsx|ts|js)$"],
      "suites": ["typecheck", "browser-smoke"],
      "nodeTests": [
        "tests/frontend-target-refresh.test.mjs",
        "tests/html-preview-sandbox.test.mjs",
        "tests/notification-ui.test.mjs",
        "tests/workbench-shell-ux.test.mjs"
      ]
    },
    {
      "id": "usage-telemetry",
      "patterns": [
        "^desktop/usage-telemetry\\.mjs$",
        "^app/application/usage-telemetry\\.ts$",
        "^tests/usage-telemetry\\.test\\.mjs$",
        "^docs/decisions/0006-pseudonymous-usage-telemetry\\.md$",
        "^docs/USAGE_TELEMETRY\\.md$",
        "^PRIVACY\\.md$"
      ],
      "suites": ["typecheck"],
      "nodeTests": [
        "tests/usage-telemetry.test.mjs",
        "tests/desktop-preload-ipc.test.mjs",
        "tests/desktop-package.test.mjs",
        "tests/notification-ui.test.mjs",
        "tests/workbench-shell-ux.test.mjs"
      ]
    },
    {
      "id": "desktop-runtime",
      "patterns": [
        "^desktop/.*\\.(?:mjs|tsx|ts|html)$",
        "^tests/(?:open-in-default-browser|preview-protocol)\\.test\\.mjs$"
      ],
      "suites": ["electron-smoke"],
      "nodeTests": [
        "tests/application-update.test.mjs",
        "tests/desktop-close-recovery.test.mjs",
        "tests/desktop-file-writer.test.mjs",
        "tests/desktop-preload-ipc.test.mjs",
        "tests/source-rename.test.mjs",
        "tests/bridge-shutdown.test.mjs",
        "tests/export-copy.test.mjs",
