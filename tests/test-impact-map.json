    {
      "id": "electron-e2e",
      "patterns": [
        "^tests/e2e/electron/(?!ai-handoff-closed-loop|packaged-(?:runtime|startup)-smoke\\.spec|playwright\\.packaged(?:-startup)?\\.config).*\\.mjs$"
      ],
      "suites": ["electron-smoke"],
      "nodeTests": []
